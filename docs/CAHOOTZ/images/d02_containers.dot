digraph{ graph [fontname="Carlito" bgcolor="white" pad=0.25 nodesep=0.35 ranksep=0.55]; node [fontname="Carlito" fontsize=12 shape=box style="rounded,filled" fillcolor="#EAF0FF" color="#2F6BFF" fontcolor="#0B1B3A" penwidth=1.2 margin="0.14,0.08"]; edge [fontname="Carlito" fontsize=10 color="#5B6478" fontcolor="#5B6478" arrowsize=0.7]; rankdir=TB; compound=true;
subgraph cluster_c{label="Clients" fontname="Carlito" color="#5B6478" style="rounded"; W[label="Next.js web app\n(React, TypeScript, Tailwind)"]; AD[label="Admin console\n(same codebase, separate route group)"];}
subgraph cluster_b{label="Backend (modular monolith, NestJS)" fontname="Carlito" color="#2F6BFF" style="rounded";
API[label="HTTP API\n(REST, versioned)"]; RT[label="Realtime gateway\n(WebSocket / Socket.IO)"]; WK[label="Background workers\n(queue consumers, schedulers)"];}
subgraph cluster_d{label="Data and platform services" fontname="Carlito" color="#5B6478" style="rounded";
PG[label="PostgreSQL\n(system of record + pgvector)" shape=cylinder]; RD[label="Redis\n(presence, pub/sub, queues, rate limits)" shape=cylinder]; R2[label="Object storage\n(Cloudflare R2 or equivalent)" shape=cylinder];}
EXT[label="External services\nemail, AI providers, payments" fillcolor="white"];
W->API[label="HTTPS"]; W->RT[label="WSS"]; AD->API;
API->PG; API->RD; API->R2; RT->RD; RT->PG[label="persist events"]; WK->PG; WK->RD; WK->EXT; API->EXT;
}