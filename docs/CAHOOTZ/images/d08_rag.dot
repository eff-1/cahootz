digraph{ graph [fontname="Carlito" bgcolor="white" pad=0.25 nodesep=0.35 ranksep=0.55]; node [fontname="Carlito" fontsize=14 shape=box style="rounded,filled" fillcolor="#EAF0FF" color="#2F6BFF" fontcolor="#0B1B3A" penwidth=1.2 margin="0.14,0.08"]; edge [fontname="Carlito" fontsize=10 color="#5B6478" fontcolor="#5B6478" arrowsize=0.7]; rankdir=TB; nodesep=0.3; ranksep=0.4;
subgraph cluster_i{label="Ingestion (asynchronous)" fontname="Carlito" fontsize=14 color="#5B6478"; UP[label="Upload / official resource"]; SC[label="Scan + type check"]; EX[label="Extract text (+OCR)"]; CH[label="Chunk + metadata\n(visibility, course, owner)"]; EM[label="Embed"]; VS[label="Vector index (pgvector)" shape=cylinder]; UP->SC->EX->CH->EM->VS;}
subgraph cluster_q{label="Answering (synchronous)" fontname="Carlito" fontsize=14 color="#2F6BFF"; Q[label="Student question"]; AC[label="Access filter\n(owner, course, institution)"]; RT[label="Retrieve top-k + rerank"]; PM[label="Prompt builder\n(untrusted-content boundaries)"]; LLM[label="Model provider\n(via abstraction)"]; AN[label="Answer + citations\n+ uncertainty note"]; Q->AC->RT->PM->LLM->AN;}
VS->RT[constraint=false];
}