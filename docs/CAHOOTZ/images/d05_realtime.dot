digraph{ graph [fontname="Carlito" bgcolor="white" pad=0.25 nodesep=0.35 ranksep=0.55]; node [fontname="Carlito" fontsize=12 shape=box style="rounded,filled" fillcolor="#EAF0FF" color="#2F6BFF" fontcolor="#0B1B3A" penwidth=1.2 margin="0.14,0.08"]; edge [fontname="Carlito" fontsize=10 color="#5B6478" fontcolor="#5B6478" arrowsize=0.7]; rankdir=LR;
C[label="Client A / B\n(browser)"]; GW[label="Realtime gateway\n(authenticates socket,\njoins session room)"]; SS[label="Session service\n(state machine,\nsingle writer per session)"]; R[label="Redis\n(presence TTL keys,\npub/sub, timers)" shape=cylinder]; PG[label="PostgreSQL\n(session_events,\nparticipants)" shape=cylinder]; Q[label="Job queue\n(deadline checks,\nsummaries, rewards)"]; N[label="Notification service\n(push, email)"];
C->GW[label="heartbeat, ack,\nping, ready"]; GW->SS[label="validated command"]; SS->PG[label="append event\n+ update state (tx)"]; SS->R[label="publish\nsession.updated"]; R->GW[label="fan-out to nodes"]; GW->C[label="state snapshot\n+ events"]; SS->Q[label="schedule deadline"]; Q->SS[label="deadline fired"]; SS->N[label="offline participant"];
}